@model WebBanHang.Models.TaiKhoan

@{
    ViewData["Title"] = "SuaThongTin";
}

<div class="page-container">

    <div class="form-panel">

        <h2>Cập Nhật Thông Tin</h2>

        <form asp-action="SuaThongTin" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="MaTk" type="hidden" />
            <input asp-for="TrangThai" type="hidden" />
            <input asp-for="NgayTao" type="hidden" />
            <input asp-for="MaVaiTro" type="hidden" />
            <input asp-for="MaDiaChi" type="hidden" />

            <div class="form-item">

                <label>Họ và tên</label>

                <input asp-for="HoTen"
                       class="form-control" />

                <span asp-validation-for="HoTen" class="text-danger"></span>

            </div>

            <div class="form-item">

                <label>Email</label>

                <input asp-for="Email"
                       class="form-control" />

                <span asp-validation-for="Email" class="text-danger"></span>

            </div>

            <div class="form-item">

                <label>Mật khẩu</label>

                <input asp-for="MatKhau"
                       type="text"
                       value="@Model.MatKhau"
                       class="form-control" />

                <span asp-validation-for="MatKhau" class="text-danger"></span>

            </div>

            <div class="form-item">

                <label>Số điện thoại</label>

                <input asp-for="SoDienThoai"
                       class="form-control" />

                <span asp-validation-for="SoDienThoai" class="text-danger"></span>

            </div>

            <button type="submit" class="btn-save">
                Lưu Thay Đổi
            </button>

        </form>

    </div>

</div>