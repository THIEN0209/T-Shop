@model IEnumerable<WebBanHang.Models.SanPham>

@{
    ViewData["Title"] = "Gắn tag sản phẩm";
}

<h2>Gắn tag sản phẩm</h2>

<div class="page-container">

    <div class="list-panel">

        <form asp-action="GanTag" method="post">

            <table class="table-danhmuc">
                <thead>
                    <tr>
                        <th>Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Tag</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        var tags = string.IsNullOrEmpty(item.TrangThai)
                        ? new List<string>()
                        : item.TrangThai.Split(',').Select(x => x.Trim()).ToList();

                        <tr>

                            <td>
                                @item.MaSp
                                <input type="hidden"
                                       name="MaSp"
                                       value="@item.MaSp" />
                            </td>

                            <td>
                                @item.TenSp
                            </td>

                            <td>
                                @item.Gia.ToString("N0") đ
                            </td>

                            <td>
                                <label style="margin-right:20px; cursor:pointer;">
                                    <input type="radio"
                                           name="Tag_@item.MaSp"
                                           value="non"
                                    @(string.IsNullOrEmpty(item.TrangThai) ? "checked" : null) />
                                    Không có
                                </label>

                                <label style="margin-right:20px; cursor:pointer;">
                                    <input type="radio"
                                           name="Tag_@item.MaSp"
                                           value="Mới"
                                    @(item.TrangThai == "Mới" ? "checked" : null) />
                                    Mới
                                </label>

                                <label style="margin-right:20px; cursor:pointer;">
                                    <input type="radio"
                                           name="Tag_@item.MaSp"
                                           value="Hàng mới về"
                                    @(item.TrangThai == "Hàng mới về" ? "checked" : null) />
                                    Hàng mới về
                                </label>

                                <label style="margin-right:20px; cursor:pointer;">
                                    <input type="radio"
                                           name="Tag_@item.MaSp"
                                           value="Bán chạy"
                                    @(item.TrangThai == "Bán chạy" ? "checked" : null) />
                                    Bán chạy
                                </label>

                                <label style="cursor:pointer;">
                                    <input type="radio"
                                           disabled
                                    @(!string.IsNullOrEmpty(item.TrangThai)
                                        && item.TrangThai != "Mới"
                                        && item.TrangThai != "Hàng mới về"
                                        && item.TrangThai != "Bán chạy"
                                        ? "checked" : null) />
                                    Có tag bên giảm giá
                                </label>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <div style="margin-top:20px;text-align:right;">
                <button type="submit" class="btn-save">
                    Lưu thay đổi
                </button>
            </div>

        </form>

    </div>

</div>
@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Thành công',
                text: '@Html.Raw(TempData["Success"])',
                timer: 1800,
                showConfirmButton: false
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: '@Html.Raw(TempData["Error"])'
            });
        </script>
    }
}