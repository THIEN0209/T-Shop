@model IEnumerable<WebBanHang.Models.DonHang>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}


<h2 class="page-title">
    Quản lý đơn hàng
</h2>
<form asp-controller="Admin" asp-action="QuanLyDonHang" method="get" class="d-inline-flex align-items-end gap-2">

    <div>
        <label for="ngay" class="form-label">Lọc theo ngày</label>
        <input type="date"
               id="ngay"
               name="ngay"
               class="form-control"
               style="width:180px"
               value="@Context.Request.Query["ngay"]" />
    </div>

    <button type="submit" class="btn btn-primary">Tìm</button>

    <a asp-controller="Admin"
       asp-action="QuanLyDonHang"
       class="btn btn-detail">
        Tất cả
    </a>

</form>
<table class="order-table">

    <thead>

        <tr>

            <th>Mã đơn</th>

            <th>Khách hàng</th>

            <th>Ngày đặt</th>

            <th>Tổng tiền</th>

            <th>Thanh toán</th>

            <th>Trạng thái</th>

            <th>Thao tác</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {

            <tr>

                <td>
                    #@item.MaDh
                </td>

                <td>
                    @item.MaTkNavigation.HoTen
                </td>

                <td>
                    @item.NgayDat.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td class="price">
                    @item.TongTien.ToString("N0") đ
                </td>

                <td>

                    @if (item.TrangThaiThanhToan == "Đã thanh toán")
                    {
                        <span class="badge paid">
                            Đã thanh toán
                        </span>
                    }
                    else
                    {
                        <span class="badge unpaid">
                            Chưa thanh toán
                        </span>
                    }

                </td>

                <td>

                    @if (item.TrangThai == "Chờ xác nhận")
                    {
                        <span class="badge waiting">
                            Chờ xác nhận
                        </span>
                    }
                    else if (item.TrangThai == "Đã xác nhận")
                    {
                        <span class="badge confirmed">
                            Đã xác nhận
                        </span>
                    }
                    else if (item.TrangThai == "Đã xử lý đổi trả")
                    {
                        <span class="badge confirmed">
                            Đã xử lý đổi trả
                        </span>
                    }
                    else if (item.TrangThai == "Chờ xử lý")
                    {
                        <span class="badge confirmed">
                            Chờ xử lý
                        </span>
                    }
                    else if (item.TrangThai == "Đang giao")
                    {
                        <span class="badge shipping">
                            Đang giao
                        </span>
                    }
                    else if (item.TrangThai == "Hoàn thành")
                    {
                        <span class="badge shipping">
                            Hoàn thành
                        </span>
                    }
                    else
                    {
                        <span class="badge cancel">
                            Đã hủy
                        </span>
                    }

                </td>

                <td>

                    <a asp-action="ChiTietDonHang"
                       asp-route-id="@item.MaDh"
                       class="btn-custom btn-detail">

                        Chi tiết

                    </a>

                    @if (item.TrangThai == "Chờ xác nhận")
                    {
                        <a asp-action="XacNhanDon"
                           asp-route-id="@item.MaDh"
                           class="btn-custom btn-confirm"
                           onclick="return confirm('Xác nhận đơn hàng này?')">

                            Duyệt

                        </a>
                    }

                </td>

            </tr>

        }

    </tbody>

</table>
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Thành công',
                text: '@Html.Raw(@TempData["Success"])',
                timer: 2000,
                showConfirmButton: false
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: '@Html.Raw(@TempData["Error"])'
            });
        </script>
    }



}