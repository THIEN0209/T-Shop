@model WebBanHang.Models.LoaiSanPham

@{
    ViewData["Title"] = "Quản Lý Loại Sản Phẩm";
}

<div class="page-container">

    <div class="form-panel">

        <h2>Thêm Loại Sản Phẩm</h2>

        <form asp-action="ThemLoaiSanPham" method="post">

            <div class="form-item">
                <label>Mã Loại</label>
                <input asp-for="MaLoai" class="form-control" />
            </div>

            <div class="form-item">
                <label>Tên Loại</label>
                <input asp-for="TenLoai" class="form-control" />
            </div>

            <div class="form-item">
                <label>Danh Mục</label>

                <select asp-for="MaDanhMuc" class="form-control">

                    @foreach (var item in ViewBag.DanhMuc)
                    {
                        <option value="@item.MaDanhMuc">
                            @item.TenDanhMuc
                        </option>
                    }

                </select>

            </div>

            <button type="submit" class="btn-save">
                Thêm Loại Sản Phẩm
            </button>

        </form>

    </div>

    <div class="list-panel">

        <h2>Danh Sách Loại Sản Phẩm</h2>

        <table class="table-danhmuc">

            <thead>
                <tr>
                    <th>Mã Loại</th>
                    <th>Tên Loại</th>
                    <th>Danh Mục</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in ViewBag.list)
                {
                    <tr>

                        <td>@item.MaLoai</td>

                        <td>@item.TenLoai</td>

                        <td>@item.MaDanhMucNavigation.TenDanhMuc</td>

                        <td>
                        <td>
                            <a asp-action="SuaLoaiSanPham"
                               asp-route-id="@item.MaLoai"
                               class="btn-edit">
                                Sửa
                            </a>

                            <a href="#"
                               class="btn-delete btnXoa"
                               data-id="@item.MaLoai">
                                Xóa
                            </a>
                        </td>
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Thành công',
                text: '@Html.Raw(TempData["Success"])',
                timer: 2000,
                showConfirmButton: false
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: '@Html.Raw(TempData["Error"])',
            });
        </script>
    }

    <script>

        document.querySelectorAll(".btnXoa").forEach(btn => {

            btn.addEventListener("click", function (e) {

                e.preventDefault();

                let id = this.dataset.id;

                Swal.fire({
                    title: 'Bạn có chắc?',
                    text: 'Loại sản phẩm sẽ bị xóa!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy'
                }).then((result) => {

                    if (result.isConfirmed) {

                        window.location.href = "/Admin/XoaLoaiSanPham/" + id;

                    }

                });

            });

        });

    </script>

}