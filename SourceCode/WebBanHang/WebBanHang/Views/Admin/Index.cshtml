@using System.Text.Json

@{
    ViewData["Title"] = "Thống kê doanh thu";

    var doanhThu = ViewBag.DoanhThu as double[];
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container mt-4">

    <div class="row mb-4">

        <div class="col-md-3">

            <select class="form-select"
                    onchange="location.href='?nam='+this.value">

                @foreach (int y in ViewBag.NamList)
                {
                    <option value="@y"
                            selected="@(y==ViewBag.Nam)">
                        @y
                    </option>
                }

            </select>

        </div>

    </div>


    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h6>Tổng doanh thu</h6>

                    <h3 class="text-success">
                        @(((double)ViewBag.TongDoanhThu).ToString("N0")) đ
                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h6>Số đơn thành công</h6>

                    <h3 class="text-primary">

                        @ViewBag.SoDon

                    </h3>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow">

                <div class="card-body text-center">

                    <h6>Giá trị trung bình</h6>

                    <h3 class="text-danger">

                        @(((double)ViewBag.TrungBinh).ToString("N0")) đ

                    </h3>

                </div>

            </div>

        </div>

    </div>


    <div class="card shadow">

        <div class="card-header">

            <b>Doanh thu năm @ViewBag.Nam</b>

        </div>

        <div class="card-body">

            <canvas id="chart" height="90"></canvas>

        </div>

    </div>

</div>


<script>

    const doanhThu = @Html.Raw(JsonSerializer.Serialize(doanhThu));

    const ctx = document.getElementById('chart');

    new Chart(ctx, {

        type: 'bar',

        data: {

            labels: [

                'Tháng 1',
                'Tháng 2',
                'Tháng 3',
                'Tháng 4',
                'Tháng 5',
                'Tháng 6',
                'Tháng 7',
                'Tháng 8',
                'Tháng 9',
                'Tháng 10',
                'Tháng 11',
                'Tháng 12'

            ],

            datasets: [

                {

                    label: 'Doanh thu',

                    data: doanhThu,

                    borderWidth: 1

                }

            ]

        },

        options: {

            responsive: true,

            plugins: {

                legend: {

                    display: true

                }

            },

            scales: {

                y: {

                    beginAtZero: true

                }

            }

        }

    });

</script>