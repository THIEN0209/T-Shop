@model WebBanHang.Models.SanPham

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

<div class="page-container">

    <div class="form-panel">

        <h2>Thêm Sản Phẩm</h2>

        <form asp-action="ThemSanPham" method="post">

            <div class="form-item">
                <label>Mã Sản Phẩm</label>
                <input asp-for="MaSp" class="form-control" />
            </div>

            <div class="form-item">
                <label>Tên Sản Phẩm</label>
                <input asp-for="TenSp" class="form-control" />
            </div>

            <div class="form-item">
                <label>Loại Sản Phẩm</label>

                <select asp-for="MaLoai" class="form-control">

                    @foreach (var item in ViewBag.listLoai)
                    {
                        <option value="@item.MaLoai">
                            @item.TenLoai
                        </option>
                    }

                </select>

            </div>

            <div class="form-item">
                <label>Giới Tính</label>

                <select asp-for="GioiTinh" class="form-control">
                    <option value="0">Nam</option>
                    <option value="1">Nữ</option>
                    <option value="2">Unisex</option>
                </select>

            </div>

            <div class="form-item">
                <label>Mô Tả</label>

                <textarea asp-for="MoTa"
                          class="form-control"
                          rows="5"></textarea>

            </div>
            <div class="form-item">

                <label>Giá bán</label>

                <input asp-for="Gia"
                       type="number"
                       class="form-control"
                       min="0"
                       step="1000" />

            </div>
            <button type="submit" class="btn-save">
                Thêm Sản Phẩm
            </button>

        </form>

    </div>

    <div class="list-panel">

        <h2>Danh Sách Sản Phẩm</h2>

        <table class="table-danhmuc">

            <thead>

                <tr>

                    <th>Mã</th>
                    <th>Tên Sản Phẩm</th>
                    <th>Loại</th>
                    <th>Giới Tính</th>
                    <th>Mô Tả</th>
                    <th>Giá</th>
                    <th>Chức Năng</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in ViewBag.list)
                {
                    <tr>

                        <td>@item.MaSp</td>

                        <td>@item.TenSp</td>

                        <td>@item.MaLoaiNavigation?.TenLoai</td>

                        <td>

                            @if (item.GioiTinh == 0)
                            {
                                <span>Nam</span>
                            }
                            else if (item.GioiTinh == 1)
                            {
                                <span>Nữ</span>
                            }
                            else
                            {
                                <span>Unisex</span>
                            }

                        </td>

                        <td>
                            @(item.MoTa != null && item.MoTa.Length > 40
                                ? item.MoTa.Substring(0, 40) + "..."
                                : item.MoTa)
                        </td>
                        <td>@item.Gia.ToString("N0") đ</td>
                        <td style="text-align:center;">

                            <div style="display:flex;justify-content:center;gap:8px;">

                                <a asp-action="SuaSanPham"
                                   asp-route-id="@item.MaSp"
                                   class="btn-edit">
                                    Sửa
                                </a>

                                <a href="#"
                                   class="btn-delete btnXoa"
                                   data-id="@item.MaSp">
                                    Xóa
                                </a>

                            </div>

                            <div style="margin-top: 8px;">

                                <a asp-action="ThemChiTietSanPham"
                                   asp-route-id="@item.MaSp"
                                   class="btn-save"
                                   style="
           display: inline-block;
           padding: 6px 14px;
           font-size: 14px;
           color: #007bff;
           background-color: #f0f7ff;
           border: 1px solid #b3d7ff;
           border-radius: 4px;
           text-decoration: none;
           font-family: sans-serif;
           ">
                                    Thêm Chi Tiết
                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Thành công',
                text: '@Html.Raw(TempData["Success"])',
                timer: 2000,
                showConfirmButton: false
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: '@Html.Raw(TempData["Error"])',
            });
        </script>
    }
    <script>

        document.querySelectorAll(".btnXoa").forEach(btn=>{

            btn.addEventListener("click",function(e){

                e.preventDefault();

                let id=this.dataset.id;

                Swal.fire({

                    title:'Bạn có chắc?',
                    text:'Sản phẩm sẽ bị xóa!',
                    icon:'warning',
                    showCancelButton:true,
                    confirmButtonColor:'#d33',
                    cancelButtonColor:'#6c757d',
                    confirmButtonText:'Xóa',
                    cancelButtonText:'Hủy'

                }).then((result)=>{

                    if(result.isConfirmed){

                        window.location.href="/Admin/XoaSanPham/"+id;

                    }

                });

            });

        });

    </script>

}