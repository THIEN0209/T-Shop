@model WebBanHang.Models.BaiViet

@{
    ViewData["Title"] = "Quản Lý Bài Viết";
}

<div class="page-container">

    <div class="form-panel">

        <h2>Thêm Bài Viết</h2>

        <form asp-action="ThemBaiViet" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-item">
                <label>Tên bài viết</label>
                <input asp-for="TenBaiViet" class="form-control" />
                <span asp-validation-for="TenBaiViet" class="text-danger"></span>
            </div>

            <div class="form-item">
                <label>Link bài viết</label>
                <input asp-for="LinkBaiViet" class="form-control" />
                <span asp-validation-for="LinkBaiViet" class="text-danger"></span>
            </div>

            <div class="form-item">
                <label>Loại bài viết</label>

                <select asp-for="Loai" class="form-control">
                    <option value="1">Bài viết chính sách</option>
                    <option value="2">Bài viết sản phẩm</option>
                </select>

                <span asp-validation-for="Loai" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-save">
                Thêm Bài Viết
            </button>

        </form>

    </div>

    <div class="list-panel">

        <h2>Danh Sách Bài Viết</h2>

        <table class="table-danhmuc">

            <thead>

                <tr>
                    <th>Mã</th>
                    <th>Tên bài viết</th>
                    <th>Link</th>
                    <th>Loại</th>
                    <th width="120"></th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in ViewBag.list)
                {
                    <tr>

                        <td>@item.MaBaiViet</td>

                        <td>@item.TenBaiViet</td>

                        <td>
                            @if (!string.IsNullOrEmpty(item.LinkBaiViet))
                            {
                                <a href="@item.LinkBaiViet" target="_blank">
                                    Xem bài viết
                                </a>
                            }
                        </td>

                        <td>
                            @(item.Loai == 1 ? "Bài viết chính sách" : "Bài viết sản phẩm")
                        </td>

                        <td>
                            @if (item.Loai == 2)
                            {
                                <a asp-action="ThemSanPhamBaiViet"
                                   asp-route-id="@item.MaBaiViet"
                                   class="btn-save">
                                    Thêm sản phẩm
                                </a>
                            }
                            <a asp-action="SuaBaiViet"
                               asp-route-id="@item.MaBaiViet"
                               class="btn-edit">
                                Sửa
                            </a>

                            <a href="#"
                               class="btn-delete btnXoa"
                               data-id="@item.MaBaiViet">
                                Xóa
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts
{

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Thành công',
                text: '@Html.Raw(TempData["Success"])',
                timer: 2000,
                showConfirmButton: false
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: '@Html.Raw(TempData["Error"])'
            });
        </script>
    }

    <script>

        document.querySelectorAll(".btnXoa").forEach(btn => {

            btn.addEventListener("click", function (e) {

                e.preventDefault();

                let id = this.dataset.id;

                Swal.fire({

                    title: 'Bạn có chắc?',
                    text: 'Bài viết sẽ bị xóa!',
                    icon: 'warning',

                    showCancelButton: true,

                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',

                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy'

                }).then((result) => {

                    if (result.isConfirmed) {

                        window.location.href = "/Admin/XoaBaiViet/" + id;

                    }

                });

            });

        });

    </script>

}