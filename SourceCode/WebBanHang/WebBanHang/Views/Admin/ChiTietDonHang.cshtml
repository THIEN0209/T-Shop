@model WebBanHang.Models.DonHang

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h2>Chi tiết đơn hàng #@Model.MaDh</h2>

<div class="info">

    <div class="card">

        <h4>Thông tin khách hàng</h4>

        <p><b>Khách:</b> @Model.MaTkNavigation.HoTen</p>

        <p><b>SĐT:</b> @Model.MaTkNavigation.SoDienThoai</p>

        <p><b>Email:</b> @Model.MaTkNavigation.Email</p>

    </div>

    <div class="card">

        <h4>Thông tin đơn hàng</h4>

        <p><b>Ngày đặt:</b> @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>

        <p><b>Thanh toán:</b> @Model.TrangThaiThanhToan</p>

        <p><b>PTTT:</b> @Model.MaPtttNavigation?.TenPttt</p>

        <p><b>Trạng thái:</b> @Model.TrangThai</p>

        <p><b>Ghi chú:</b> @Model.GhiChu</p>

    </div>

</div>

<h3>Sản phẩm</h3>

<table class="table-order">

    <thead>

        <tr>

            <th>Ảnh</th>

            <th>Tên sản phẩm</th>

            <th>Màu</th>

            <th>Size</th>

            <th>SL</th>

            <th>Đơn giá</th>

            <th>Thành tiền</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model.ChiTietDonHangs)
        {
            var anh = item.MaCtspNavigation.MaSpNavigation.HinhAnhSanPhams.FirstOrDefault();

            <tr>

                <td>

                   
                        <img src="~/imageSP/@($"{item.MaCtspNavigation.MaSpNavigation.MaSp}_{item.MaCtspNavigation.MaMau}.png")" />
                    

                </td>

                <td>

                    @item.MaCtspNavigation.MaSpNavigation.TenSp

                </td>

                <td>

                    @item.MaCtspNavigation.MaMauNavigation.TenMau

                </td>

                <td>

                    @item.MaCtspNavigation.MaSizeNavigation.TenSize

                </td>

                <td>

                    @item.SoLuong

                </td>

                <td>

                    @item.DonGia.ToString("N0") đ

                </td>

                <td>

                    @item.ThanhTien.ToString("N0") đ

                </td>

            </tr>
        }

    </tbody>

</table>

<h3 class="tongtien">

    Tổng tiền:
    <span>@Model.TongTien.ToString("N0") đ</span>

</h3>

<div class="button">

    <a asp-action="QuanLyDonHang" class="btn-back">

        Quay lại

    </a>

    @if (Model.TrangThai == "Chờ xác nhận")
    {
        <a asp-action="XacNhanDon"
           asp-route-id="@Model.MaDh"
           class="btn-confirm">

            Duyệt đơn

        </a>
    }

</div>