@model IEnumerable<WebBanHang.Models.DonHang>

@{
    var kh = ViewBag.KhachHang as WebBanHang.Models.TaiKhoan;
}

<h2 class="page-title">
    Danh sách đơn hàng của khách hàng
</h2>

@if (kh != null)
{
    <div class="card" style="margin-bottom:20px; padding:20px;">
        <h4>Thông tin khách hàng</h4>

        <p><strong>Mã khách:</strong> #@kh.MaTk</p>

        <p><strong>Họ tên:</strong> @kh.HoTen</p>

        <p><strong>Email:</strong> @kh.Email</p>

        <p><strong>Số điện thoại:</strong> @kh.SoDienThoai</p>

        <p><strong>Ngày tạo:</strong> @kh.NgayTao.ToString("dd/MM/yyyy")</p>

        <p>
            <strong>Trạng thái:</strong>

            @if (kh.TrangThai == true)
            {
                <span class="badge paid">Hoạt động</span>
            }
            else
            {
                <span class="badge cancel">Đã khóa</span>
            }

        </p>
    </div>
}

<table class="order-table">

    <thead>

        <tr>

            <th>Mã đơn</th>

            <th>Khách hàng</th>

            <th>Ngày đặt</th>

            <th>Tổng tiền</th>

            <th>Thanh toán</th>

            <th>Trạng thái</th>

            <th>Thao tác</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {

            <tr>

                <td>
                    #@item.MaDh
                </td>

                <td>
                    @item.MaTkNavigation.HoTen
                </td>

                <td>
                    @item.NgayDat.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td class="price">
                    @item.TongTien.ToString("N0") đ
                </td>

                <td>

                    @if (item.TrangThaiThanhToan == "Đã thanh toán")
                    {
                        <span class="badge paid">
                            Đã thanh toán
                        </span>
                    }
                    else
                    {
                        <span class="badge unpaid">
                            Chưa thanh toán
                        </span>
                    }

                </td>

                <td>

                    @if (item.TrangThai == "Chờ xác nhận")
                    {
                        <span class="badge waiting">
                            Chờ xác nhận
                        </span>
                    }
                    else if (item.TrangThai == "Đã xác nhận")
                    {
                        <span class="badge confirmed">
                            Đã xác nhận
                        </span>
                    }
                    else if (item.TrangThai == "Đang giao")
                    {
                        <span class="badge shipping">
                            Đang giao
                        </span>
                    }
                    else if (item.TrangThai == "Đã giao")
                    {
                        <span class="badge done">
                            Đã giao
                        </span>
                    }
                    else
                    {
                        <span class="badge cancel">
                            Đã hủy
                        </span>
                    }

                </td>

                <td>

                    <a asp-action="ChiTietDonHang"
                       asp-route-id="@item.MaDh"
                       class="btn-custom btn-detail">

                        Chi tiết

                    </a>

                    @if (item.TrangThai == "Chờ xác nhận")
                    {
                        <a asp-action="XacNhanDon"
                           asp-route-id="@item.MaDh"
                           class="btn-custom btn-confirm"
                           onclick="return confirm('Xác nhận đơn hàng này?')">

                            Duyệt

                        </a>
                    }

                </td>

            </tr>

        }

    </tbody>

</table>
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Thành công',
                text: '@Html.Raw(@TempData["Success"])',
                timer: 2000,
                showConfirmButton: false
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: '@Html.Raw(@TempData["Error"])'
            });
        </script>
    }



}