@model WebBanHang.Models.DanhMuc

@{
    ViewData["Title"] = "Sửa Danh Mục";
}

<div class="page-container">

    <div class="form-panel" style="max-width:600px;margin:auto;">

        <h2>Sửa Danh Mục</h2>

        <form asp-action="SuaDanhMuc" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-item">
                <label>Mã Danh Mục</label>

                <input asp-for="MaDanhMuc"
                       class="form-control"
                       readonly />

                <span asp-validation-for="MaDanhMuc" class="text-danger"></span>
            </div>

            <div class="form-item">

                <label>Tên Danh Mục</label>

                <input asp-for="TenDanhMuc"
                       class="form-control" />

                <span asp-validation-for="TenDanhMuc" class="text-danger"></span>

            </div>

            <div style="display:flex;gap:12px;margin-top:25px;">

                <button type="submit" class="btn-save">
                    Lưu Thay Đổi
                </button>

                <a asp-action="QuanLyDanhMuc"
                   class="btn-cancel">
                    Quay Lại
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Thành công',
                text: '@Html.Raw(TempData["Success"])',
                timer: 2000,
                showConfirmButton: false
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: '@Html.Raw(TempData["Error"])',
            });
        </script>
    }
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}