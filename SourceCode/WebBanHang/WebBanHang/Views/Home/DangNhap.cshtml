@model WebBanHang.Models.TaiKhoan

<div class="login-box">
    <h2>Đăng Nhập</h2>
    <p class="login-text">Vui lòng đăng nhập để tiếp tục.</p>

    <form asp-action="DangNhap" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-item">
            <label>Số điện thoại</label>
            <input asp-for="SoDienThoai" class="form-control" placeholder="Nhập số điện thoại..." />
            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
        </div>

        <div class="form-item">
            <label>Mật khẩu</label>
            <input asp-for="MatKhau" type="password" class="form-control" placeholder="Nhập mật khẩu..." />
            <span asp-validation-for="MatKhau" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-login">Đăng Nhập</button>
    </form>

    <div class="login-footer">
        Chưa có tài khoản?
        <a asp-controller="Home" asp-action="DangKy">Đăng ký ngay</a>
        <!-- Lưu ý: Đổi asp-controller thành TaiKhoan nếu bạn để hàm DangKy ở TaiKhoanController -->
    </div>
</div>

<!-- ĐƯA ĐOẠN ĐỌC TEMPDATA VÀO ĐÂY ĐỂ ĐẢM BẢO CHẠY SAU KHI LOAD SCRIPT -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        @if (TempData["Success"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: '@Html.Raw(TempData["Success"])',
                        timer: 2000,
                        showConfirmButton: false
                    });
            </text>
        }

        @if (TempData["Error"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: '@Html.Raw(TempData["Error"])'
                    });
            </text>
        }
        });
    </script>
}