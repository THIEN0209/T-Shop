@model IEnumerable<WebBanHang.Models.GioHang>

@{
    ViewData["Title"] = "Giỏ Hàng";
}

<div class="cart-container">

    <h2>Giỏ Hàng Của Bạn</h2>

    @if (!Model.Any())
    {
        <div class="cart-empty">
            <h4>Giỏ hàng đang trống.</h4>
            <a asp-controller="Home" asp-action="Index" class="btn-shop">
                Tiếp tục mua sắm
            </a>
        </div>
    }
    else
    {
        <table class="cart-table">

            <thead>

                <tr>
                    <th>Sản phẩm</th>
                    <th>Màu</th>
                    <th>Size</th>
                    <th>Đơn giá</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th></th>
                </tr>

            </thead>

            <tbody>

                @{
                    double tongTien = 0;
                }

                @foreach (var item in Model)
                {
                    double thanhTien = item.MaCtspNavigation.MaSpNavigation.Gia * item.SoLuong;
                    tongTien += thanhTien;

                    <tr>

                        <td>

                            <div class="cart-product">

                                <img src="~/imageSP/@($"{item.MaCtspNavigation.MaSpNavigation.MaSp}_{item.MaCtspNavigation.MaMau}.png")"
                                     onerror="this.src='/imageSP/@($"{item.MaCtspNavigation.MaSpNavigation.MaSp}_macdinh.png")'" />
                                <div>

                                    <strong>
                                        @item.MaCtspNavigation.MaSpNavigation.TenSp
                                    </strong>

                                </div>

                            </div>

                        </td>

                        <td>
                            @item.MaCtspNavigation.MaMauNavigation.TenMau
                        </td>

                        <td>
                            @item.MaCtspNavigation.MaSizeNavigation.TenSize
                        </td>

                        <td>
                            @item.MaCtspNavigation.MaSpNavigation.Gia.ToString("N0") đ
                        </td>

                        <td>

                            <a asp-action="GiamSoLuong"
                               asp-route-maCtsp="@item.MaCtsp"
                               style="text-decoration:none;">
                                -
                            </a>

                            <span style="margin:0 12px;">
                                @item.SoLuong
                            </span>

                            <a asp-action="TangSoLuong"
                               asp-route-maCtsp="@item.MaCtsp"
                               style="text-decoration:none;">
                                +
                            </a>

                        </td>

                        <td>
                            @thanhTien.ToString("N0") đ
                        </td>

                        <td>

                            <a asp-action="XoaKhoiGio"
                               asp-route-maCtsp="@item.MaCtsp"
                               class="btn-delete">
                                Xóa
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <div class="cart-footer">

            <div class="cart-total">

                Tổng tiền :
                <strong>
                    @tongTien.ToString("N0") đ
                </strong>

            </div>

            <a asp-controller="Home" asp-action="ThanhToan" class="btn-payment">
                Thanh Toán
            </a>

        </div>

    }

</div>
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Thành công',
                text: '@Html.Raw(@TempData["Success"])',
                timer: 2000,
                showConfirmButton: false
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: '@Html.Raw(@TempData["Error"])'
            });
        </script>
    }



}