@model IEnumerable<NhanVienGiaoHang.Models.DonHang>
@{
    ViewData["Title"] = "Lịch sử giao hàng";
}

<h5 class="mb-3">Lịch sử đơn đã giao</h5>

@if (!Model.Any())
{
    <p class="text-muted text-center mt-5">Chưa có đơn hàng nào hoàn thành.</p>
}

@foreach (var item in Model)
{
    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h6 class="mb-0">Đơn #@item.MaDh</h6>
                <span class="badge bg-success">@item.TrangThai</span>
            </div>

            <p class="mb-1 small text-muted">
                <i class="bi bi-calendar"></i> @item.NgayDat.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p class="mb-1">
                <i class="bi bi-geo-alt"></i>
                @item.MaDiaChiNavigation.DiaChiCuThe, @item.MaDiaChiNavigation.PhuongXa,
                @item.MaDiaChiNavigation.QuanHuyen, @item.MaDiaChiNavigation.TinhThanh
            </p>

            <p class="mb-1">
                <i class="bi bi-cash"></i> Tổng tiền: <strong>@item.TongTien.ToString("N0") đ</strong>
            </p>

            <p class="mb-2">
                <i class="bi bi-credit-card"></i> Thanh toán: @item.TrangThaiThanhToan
            </p>
        </div>
    </div>
}