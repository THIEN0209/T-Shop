@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    bool laTrangDangNhap = currentController == "Home" && currentAction == "DangNhap";

    if (!laTrangDangNhap && Context.Session.GetInt32("MaTk") == null)
    {
        Context.Response.Redirect("/Home/DangNhap");
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - NhanVienGiaoHang</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NhanVienGiaoHang.styles.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        body {
            background-color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            padding-bottom: 70px;
        }

        main {
            padding: 15px;
        }

        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 65px;
            background-color: #ffffff;
            border-top: 1px solid #dee2e6;
            display: flex;
            justify-content: space-around;
            align-items: center;
            z-index: 1030;
        }

        .nav-item-mobile {
            text-decoration: none;
            color: #6c757d;
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 11px;
            font-weight: 500;
            flex: 1;
            transition: color 0.2s ease;
            background: none;
            border: none;
        }

            .nav-item-mobile i {
                font-size: 22px;
                margin-bottom: 2px;
            }

            .nav-item-mobile.active {
                color: #198754;
            }

            .nav-item-mobile.logout {
                color: #dc3545;
            }
    </style>
</head>
<body>

    <main role="main">
        @RenderBody()
    </main>

    <nav class="bottom-nav">
        <a href="/Home/Index" class="nav-item-mobile active">
            <i class="bi bi-box-seam-fill"></i>
            <span>Chờ giao</span>
        </a>

        <a href="/Home/DaNhan" class="nav-item-mobile">
            <i class="bi bi-check-circle-fill"></i>
            <span>Đã nhận</span>
        </a>
        <a href="/Home/LichSu" class="nav-item-mobile">
            <i class="bi bi-check-circle-fill"></i>
            <span>Lịch sử giao hàng</span>
        </a>
        <form asp-controller="Home" asp-action="DangXuat" method="post" class="d-flex flex-fill">
            <button type="submit" class="nav-item-mobile logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Đăng xuất</span>
            </button>
        </form>
    </nav>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function () {
            var currentPath = window.location.pathname;
            $('.nav-item-mobile:not(.logout)').removeClass('active');
            $('.nav-item-mobile:not(.logout)').each(function () {
                var href = $(this).attr('href');
                if (currentPath === href || currentPath.startsWith(href)) {
                    $(this).addClass('active');
                }
            });
        });
    </script>
</body>
</html>